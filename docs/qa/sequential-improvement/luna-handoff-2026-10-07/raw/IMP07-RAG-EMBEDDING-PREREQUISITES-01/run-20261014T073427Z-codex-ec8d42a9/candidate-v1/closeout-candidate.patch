+    def failing_factory(model_name: str) -> _EmbeddingModel:
+        boundary.factory_models.append(model_name)
+        raise RuntimeError("controlled-loader-failure")
+
+    _install_factory(monkeypatch, failing_factory)
+    response = _post(
