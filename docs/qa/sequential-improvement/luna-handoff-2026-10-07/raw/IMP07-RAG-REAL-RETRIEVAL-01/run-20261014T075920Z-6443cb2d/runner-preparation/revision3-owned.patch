+)
+def test_post_mutation_q01_requires_current_top_five_evidence(
+    case: str, expected_rank: int | None, tmp_path: Path
+) -> None:
+    from .control import save
+    from .runner import Match, QueryResult, Snapshot, check_mutated_q01
+
+    current = (FIXTURE / "mutation/01-room-cancellations.md").read_bytes()
+    previous = (FIXTURE / "corpus-a/01-room-cancellations.md").read_bytes()
+    current_hash = hashlib.md5(current, usedforsecurity=False).hexdigest()
+    previous_hash = hashlib.md5(previous, usedforsecurity=False).hexdigest()
+    text = current.decode().strip() + "\n"
+    match: Match = {
+        "id": "current-chunk",
+        "text": text,
+        "metadata": {"source": "01-room-cancellations.md", "source_hash": current_hash},
+        "provenance": {
+            "source": "01-room-cancellations.md",
+            "source_id": "current-chunk",
+            "source_hash": current_hash,
+            "freshness": "fresh",
+        },
+    }
+    reopened: Snapshot = {
+        "collection_metadata": {},
+        "rows": [
+            {
+                "id": match["id"],
+                "document": text,
+                "metadata": {"source": "01-room-cancellations.md", "source_hash": current_hash},
+                "embedding": [],
+            }
+        ],
+    }
+    unrelated: Match = {"id": "decoy", "text": "Workshop equipment guidance", "metadata": {"source": "decoy.md"}}
+    result: QueryResult = {
+        "query_id": "Q01",
+        "project_id": "fixture-alder-a",
+        "text": "How far ahead must an organizer cancel a paid indoor workshop to receive a full refund?",
+        "matches": [match],
+        "elapsed_seconds": 0,
+    }
+    provenance = match["provenance"]
+    if case == "empty":
+        result["matches"] = []
+    elif case == "missing_source":
+        del provenance["source"]
+    elif case == "unrelated_source":
+        result["matches"] = [unrelated]
+    elif case == "rank_six":
+        result["matches"] = [unrelated] * 5 + [match]
+    elif case == "stale_source_hash":
+        match["metadata"]["source_hash"] = previous_hash
+    elif case == "stale_provenance_hash":
+        provenance["source_hash"] = previous_hash
+    elif case == "stale_content":
+        match["text"] = previous.decode()
+    elif case == "unrelated_content":
+        match["text"] = "Equipment may be borrowed for 24 hours."
+    elif case == "stale_stored_row":
+        reopened["rows"][0]["metadata"]["source_hash"] = previous_hash
+    elif case == "missing_stored_row":
+        reopened["rows"] = []
+    elif case == "stale_freshness":
+        provenance["freshness"] = "stale"
+    elif case == "mismatched_id":
+        provenance["source_id"] = "other-chunk"
+    elif case == "valid_fifth":
+        result["matches"] = [unrelated] * 4 + [match]
+    else:
+        assert case == "valid_first"
+    evidence = check_mutated_q01(result, current, previous, reopened)
+    save(tmp_path / "post-mutation-q01-check.json", {"case": case, "input": result, "check": evidence})
+    assert evidence["passed"] is (expected_rank is not None)
+    assert evidence["rank"] == expected_rank
+    assert evidence["expected_source_md5"] == current_hash != previous_hash
+    assert evidence["source_changed"]
+    if expected_rank is not None:
+        assert evidence["candidates"][0]["returned_24_hour_fact"]
+        assert evidence["candidates"][0]["absent_48_hour_fact"]
+        assert evidence["candidates"][0]["returned_content_sha256"] == hashlib.sha256(text.encode()).hexdigest()
