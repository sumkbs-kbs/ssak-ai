    @pytest.mark.parametrize("compat_case", ["lmstudio", "openrouter"], indirect=True)
    @pytest.mark.parametrize("route", ["/v1/chat/completions", "/v1/messages"])
    @pytest.mark.parametrize("payload,code", [
        (wire(ERROR), "upstream_stream_error"),
