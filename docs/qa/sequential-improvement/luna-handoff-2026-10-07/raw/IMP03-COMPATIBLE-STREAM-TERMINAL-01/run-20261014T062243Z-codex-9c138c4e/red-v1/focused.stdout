            prompt=prompt,
            raw_messages=kwargs.get("raw_messages"),
            system_prompt=cast(str, kwargs.get("system_prompt", "")),
            images=kwargs.get("images"),
        )
    
        model_name, temperature, thinking_config, _ = self._apply_dynamic_inference_config(
