        data: dict[str, object] = {
            "model": model_id,
            "messages": api_msgs,
            "stream": True,
            "temperature": temperature,
            "max_tokens": kwargs.get("max_tokens", 4096),
        }
        # "model:high/4096" 사양 → OpenRouter reasoning 파라미터로 매핑
        if thinking_config is not None and isinstance(thinking_config, dict):
