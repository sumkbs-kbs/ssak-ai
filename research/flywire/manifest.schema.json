{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssak-ai.local/research/flywire/manifest.schema.json",
  "title": "FlyWire 연구 dataset manifest",
  "description": "research/flywire/validate_dataset.py 와 extract_circuits.py 가 내는 manifest 의 계약. 이 저장소의 stdlib 검증기(flywire_contract.validate_against_schema)가 지원하는 키워드만 쓴다: type·required·properties·items·enum·const·minItems·pattern·additionalProperties.",
  "type": "object",
  "required": [
    "manifest_version",
    "dataset_id",
    "release",
    "status",
    "generated_at",
    "inputs",
    "annotation",
    "filtering_rule",
    "unknown_nt_policy",
    "root_id_index_mapping_sha256",
    "counts",
    "license",
    "code",
    "seed_policy",
    "checks"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "release": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reader": {
      "type": "string"
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "data_root": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash_seconds": {
            "type": "number"
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "version",
        "source_table",
        "cross_source_table",
        "groups"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "source_table": {
          "type": "string"
        },
        "cross_source_table": {
          "type": "string"
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "label",
              "source_column",
              "source_values",
              "count",
              "joined_neurons",
              "status"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "source_column": {
                "type": "string"
              },
              "source_values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "count": {
                "type": "integer"
              },
              "joined_neurons": {
                "type": "integer"
              },
              "status": {
                "enum": [
                  "CONFIRMED",
                  "INCONCLUSIVE",
                  "UNKNOWN"
                ]
              },
              "overlaps": {
                "type": "object"
              },
              "cross_source": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "filtering_rule": {
      "type": "object",
      "required": [
        "edge_table",
        "pair_aggregation",
        "threshold"
      ],
      "properties": {
        "edge_table": {
          "type": "string"
        },
        "pair_aggregation": {
          "type": "string"
        },
        "threshold": {
          "type": "integer"
        },
        "self_loops": {
          "type": "string"
        },
        "table_mixing": {
          "type": "string"
        }
      }
    },
    "unknown_nt_policy": {
      "type": "string"
    },
    "root_id_index_mapping_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "required": [
        "nodes",
        "directed_pairs",
        "synapses",
        "neuropil_rows",
        "edge_table"
      ],
      "properties": {
        "nodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "directed_pairs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "synapses": {
          "type": [
            "integer",
            "null"
          ]
        },
        "neuropil_rows": {
          "type": [
            "integer",
            "null"
          ]
        },
        "edge_table": {
          "type": "string"
        }
      }
    },
    "skeleton": {
      "type": [
        "object",
        "null"
      ]
    },
    "license": {
      "type": "object",
      "required": [
        "decision",
        "license",
        "evidence",
        "constraints"
      ],
      "properties": {
        "decision": {
          "enum": [
            "research_only_noncommercial_attribution",
            "unverified_no_redistribution"
          ]
        },
        "license": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "attribution": {
          "type": "string"
        },
        "constraints": {
          "type": "string"
        }
      }
    },
    "code": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "seed_policy": {
      "type": "string"
    },
    "outputs": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check",
          "ok",
          "detail"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "measured": {
            "type": "object"
          }
        }
      }
    }
  }
}
